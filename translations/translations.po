#: KrohnkiteConfigForm%23256
msgid "Override default floating window settings"
msgstr ""

#: KrohnkiteConfigForm%23257
msgid ""
"<html><head/><body><p><span style=\" font-size:10pt;\">One rule per line. "
"Format:</span></p><p><span style=\" font-size:10pt; font-weight:700;\">"
"&lt;ClassName&gt;[,&lt;ClassName&gt;...][:&lt;Title&gt;]:&lt;param&gt;=&lt;value&gt;[,&lt;param&gt;=&lt;value&gt;...]</"
"span></p><p><span style=\" font-size:10pt;\">Wrap title in [brackets] for "
"substring match, e.g. [Firefox] matches &quot;Mozilla Firefox&quot;.</span></"
"p><p><span style=\" font-size:10pt;\">Without brackets the title is matched "
"exactly.<br/></span></p><p><span style=\" font-size:10pt;\">Examples:</span>"
"</p><p><span style=\" font-size:10pt;\">Make Krohnkite settings float:</span>"
"</p><p><span style=\" font-size:10pt; font-weight:700;\">"
"systemsettings:Configure — System Settings:auto=1</span></p><p><span "
"style=\" font-size:10pt;\">Windows with windowClass </span><span style=\" "
"font-size:10pt; font-weight:700;\">konsole,kate </span><span style=\" font-"
"size:10pt;\">will always be floating with init size width/height=60% of init "
"screen and with left indent 120 pixel and top indent 10% of init screen "
"height. </span></p><p><span style=\" font-size:10pt; font-weight:700;\">"
"konsole,kate:width=60,height=60,li=120px,ti=10%</span></p><p><span style=\" "
"font-size:10pt;\">Windows with windowClass 'firefox' and title contain "
"'Firefox' word will have width: 60%,height: native and will float when open "
"by could be tile later.</span></p><p><span style=\" font-size:10pt; font-"
"weight:700;\">firefox:[Firefox]:w=60,f=false,auto=true</span></p><p><span "
"style=\" font-size:10pt;\">window with any class and 'gimp' title will have "
"shoudFloat=true</span></p><p><span style=\" font-size:10pt; font-"
"weight:700;\">:gimp: (all defaults) </span><span style=\" font-size:10pt;\">"
"<br/></span></p><p><span style=\" font-size:10pt;\">Params could be omit:</"
"span></p><p><span style=\" font-size:10pt;\">shoudFloat, f — makes window "
"float forever. true or false (default: true)</span></p><p><span style=\" "
"font-size:10pt;\">auto, a — open window float. true or false (default:  'by "
"default all new windows become floating' flag value )</span></p><p><span "
"style=\" font-size:10pt;\">width, w — 1-100 percent of screen (default: "
"inherit global)</span></p><p><span style=\" font-size:10pt;\">height, h — 1-"
"100 percent of screen (default: inherit global)</span></p><p><span style=\" "
"font-size:10pt;\">leftIndent, left, li — offset from left in px (default) or "
"% (e.g. 100, 50px, 20%). Default: inherit native</span></p><p><span style=\" "
"font-size:10pt;\">topIndent, top, ti — offset from top in px (default) or % "
"(e.g. 100, 50px, 20%). Default: inherit native</span></p><p><span style=\" "
"font-size:10pt;\">stepWidth, sw — 0-100 percent of screen width by which the "
"floating window move,expands/contracts per resize/move shortcut press "
"(default: inherit global)</span></p><p><span style=\" font-size:10pt;\">"
"stepHeight, sh — 0-100 percent of screen height by which the floating window "
"move,expands/contracts per resize/move shortcut press (default: inherit "
"global)</span></p></body></html>"
msgstr ""

