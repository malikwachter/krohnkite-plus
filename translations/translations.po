#: KrohnkiteConfigForm%23191
msgid "Sequence time"
msgstr ""

#: KrohnkiteConfigForm%23192
msgid ""
"<html><head/><body><p><span style=\" font-size:10pt;\">One rule per line. "
"Case insensitive. Format:</span></p><p><span style=\" font-size:10pt; font-"
"weight:700;\">"
"&lt;Shortcut&gt;[,&lt;Shortcut&gt;...]:&lt;flag&gt;=&lt;value&gt;[,&lt;flag&gt;=&lt;value&gt;...]</"
"span></p><p><span style=\" font-size:10pt;\">A comma-separated list of "
"shortcuts forms a key sequence that must be pressed in order. Shortcut and "
"action names are listed above in &quot;Possible shortcuts and "
"actions&quot;.</span></p><p><span style=\" font-size:10pt;\">Flags (at least "
"one action flag is required):</span></p><p><span style=\" font-size:10pt; "
"font-weight:700;\">mainaction|ma</span><span style=\" font-size:10pt;\"> — "
"the action to perform (KrohnkiteAction).</span></p><p><span style=\" font-"
"size:10pt; font-weight:700;\">registeraction|ra</span><span style=\" font-"
"size:10pt;\"> — the action to perform while the register (meta) mode is "
"active (KrohnkiteAction). Use null to clear it.</span></p><p><span style=\" "
"font-size:10pt; font-weight:700;\">null</span><span style=\" font-"
"size:10pt;\"> — clears an action: ma=null disables the normal action, "
"ra=null makes register mode fall back to the main action.</span></p><p><span "
"style=\" font-size:10pt; font-weight:700;\">sequencetime|st</span><span "
"style=\" font-size:10pt;\"> — milliseconds, overrides the &quot;Sequence "
"time&quot; setting for that rule.</span></p><p><span style=\" font-"
"size:10pt;\">Examples:</span></p><p><span style=\" font-size:10pt; font-"
"weight:700;\">MoveLeftSC:ra=swapleft</span><span style=\" font-size:10pt;\"> "
"— assign SwapLeft action to MoveLeftSC shortcut when register is on. </span>"
"</p><p><span style=\" font-size:10pt; font-weight:700;\">MoveDownSC:ra=null</"
"span><span style=\" font-size:10pt;\"> — do not override the main action: "
"MoveDownSC keeps using MoveDown while register is on.</span></p><p><span "
"style=\" font-size:10pt; font-weight:700;\">"
"GrowWidthSC,ShrinkWidthSC:ma=resetSurfaceCapacity,st=500</span><span "
"style=\" font-size:10pt;\"> — assign shortcut sequence with sequence time "
"overriding to 500 ml with main action to reset srf capacity.</span></p></"
"body></html>"
msgstr ""

